ODDS_API_KEY=your_api_key_here

# --- Auto-hedger: Polymarket CLOB order placement (python -m bonusarb auto) ---
# Private key for the browser wallet you deposited to Polymarket with. Keep
# this secret; it can move funds on Polygon.
POLYMARKET_PRIVATE_KEY=0xyour_wallet_private_key
# The Polymarket proxy / Safe address that actually holds your deposited USDC.
# For a MetaMask-deposited account this is your Polymarket deposit (Safe) addr.
POLYMARKET_FUNDER_ADDRESS=0xyour_polymarket_proxy_address
# 1 = POLY_PROXY, 2 = POLY_GNOSIS_SAFE. Browser deposits usually use 2.
POLYMARKET_SIGNATURE_TYPE=2
POLYMARKET_CHAIN_ID=137
# Optional: override the CLOB host (defaults to https://clob.polymarket.com).
# POLYMARKET_CLOB_HOST=https://clob.polymarket.com
# Sports taker fee rate used to haircut Polymarket hedge odds (default 0.05).
# POLYMARKET_SPORTS_TAKER_FEE_RATE=0.05

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Auto-hedger safety knobs ---
# Minimum locked profit (USD) required to place a hedge after line movement.
AUTO_MIN_LOCKED_PROFIT_FLOOR=1.0
# Maximum acceptable price slippage vs live quote when placing a hedge.
AUTO_MAX_SLIPPAGE=0.02
# Seconds between resolution polls.
AUTO_POLL_INTERVAL_SECONDS=60
# Asymmetric resolution thresholds (hedge share price on Polymarket):
# Declare leg LOST (stop) when hedge price >= AUTO_LOST_THRESHOLD (default 0.97).
AUTO_LOST_THRESHOLD=0.97
# Declare leg WON (place next hedge) when hedge price <= 1 - AUTO_WON_THRESHOLD (default 0.01).
AUTO_WON_THRESHOLD=0.99
# Legacy alias for AUTO_LOST_THRESHOLD (optional).
# AUTO_DECIDED_THRESHOLD=0.97
# Minimum order size in shares; Polymarket rejects tiny orders.
AUTO_MIN_ORDER_SHARES=5
# Seconds to wait for a limit order to fill before cancelling the remainder.
AUTO_ORDER_FILL_SECONDS=30

# --- CAD / USD FX (stakes default to CAD on python -m bonusarb and auto) ---
# Live rate source (CAD per 1 USD). Override with --fx-rate on the CLI.
# AUTO_FX_SOURCE=https://open.er-api.com/v6/latest/USD
